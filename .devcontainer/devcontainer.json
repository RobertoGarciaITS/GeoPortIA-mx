{
  "name": "GeoOpportunity MX — Codespaces Free Tier",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/python:1": { "version": "3.12" },
    "ghcr.io/devcontainers/features/node:1": { "version": "22" },
    "ghcr.io/devcontainers/features/google-cloud-cli:1": {}
  },
  "postCreateCommand": "pip install --user -r apps/api/requirements.txt && cd apps/web && npm install",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "GeoPortIA API", "onAutoForward": "notify" },
    "5173": { "label": "GeoPortIA Web", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
